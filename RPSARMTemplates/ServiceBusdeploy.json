{
  "$schema": "https://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "serviceBusNamespace": {
      "type": "string",
      "minLength": 5,
      "maxLength": 35
    },
    "serviceBusNamespaceLocation": {
      "type": "string",
      "allowedValues": [
        "Central India",
        "Center US",
        "East US",
        "North Europe",
        "West Europe"
      ],
      "defaultValue": "West Europe"
    },
    "serviceBusQueueName": {
      "type": "string",
      "minLength": 5,
      "maxLength": 35
    },
    "serviceBusTopicName": {
      "type": "string",
      "minLength": 5,
      "maxLength": 35
    },
    "serviceBusTopicSubscriptionName": {
      "type": "string",
      "minLength": 5,
      "maxLength": 35
    }
  },
  "variables": {
    "serviceBusNamespaceUniqueName": "[concat('srvbus-ns-',parameters('serviceBusNamespace'))]",
    "serviceBusQueueUniqueName": "[concat('srvbus-queue-',parameters('serviceBusQueueName'))]",
    "serviceBusTopicUniqueName": "[concat('srvbus-topic-',parameters('serviceBusTopicName'))]",
    "defaultSASKeyName": "RootManageSharedAccessKey",
    "serviceBusApiVersion": "2018-01-01-preview",
    "authRuleResourceId": "[resourceId('Microsoft.ServiceBus/namespaces/authorizationRules',variables('serviceBusNamespaceUniqueName'),variables('defaultSASKeyName'))]"
  },
  "resources": [
    {
      "metadata": {
        "description": "This template definition craetes Service Bus Namespace, a queue, a topic and its subscription"
      },
      "type": "Microsoft.ServiceBus/namespaces",
      "apiVersion": "2018-01-01-preview",
      "name": "[variables('serviceBusNamespaceUniqueName')]",
      "location": "[parameters('serviceBusNamespaceLocation')]",
      "sku": {
        "tier": "Standard",
        "capacity": 2,
        "name": "Standard"
      },
      "properties": {},
      "resources": [
        {
          "type": "queues",
          "apiVersion": "2017-04-01",
          "name": "[variables('serviceBusQueueUniqueName')]",
          "dependsOn": [
            "[variables('serviceBusNamespaceUniqueName')]"
          ],
          "properties": {
            "maxSizeInMegabytes": 4096,
            "defaultMessageTimeToLive": "P1D",
            "enablePartitioning": true,
            "lockDuration": "PT30S",
            "maxDeliveryCount": 5,
            "status": "Active"
          }
        },
        {
          "type": "topics",
          "apiVersion": "2017-04-01",
          "name": "[variables('serviceBusTopicUniqueName')]",
          "dependsOn": [
            "[variables('serviceBusNamespaceUniqueName')]"
          ],
          "properties": {
            "maxSizeInMegabytes": 4096,
            "enablePartitioning": true,
            "metadata": {
              "description": "The Time to Live properties takes vaule in ISO 8601 format which is P1Y3M10DT1H13M23S where P stands for period and T for Time"
            },
            "defaultMessageTimeToLive": "P14D"
          },
          "resources": [
            {
              "type": "subscriptions",
              "apiVersion": "2017-04-01",
              "name": "[parameters('serviceBusTopicSubscriptionName')]",
              "properties": {
                "defaultMessageTimeToLive": "P10D",
                "lockDuration": "PT30S",
                "maxDeliveryCount": 10,
                "status": "Active"
              },
              "dependsOn": [
                "[variables('serviceBusTopicUniqueName')]"
              ]
            }
          ]
        }
      ]
    }
  ],
  "outputs": {
    "serviceBusNamespaceConString": {
      "type": "string",
      "value": "[listKeys(variables('authRuleResourceId'),variables('serviceBusApiVersion')).primaryConnectionString]"
    },
    "serviceBusSASPrimaryKey": {
      "type": "string",
      "value": "[listKeys(variables('authRuleResourceId'),variables('serviceBusApiVersion')).keys[0]]"
    }
  }
}


