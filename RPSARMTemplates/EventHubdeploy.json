{
  "$schema": "https://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "eventHubNamespaceName": {
      "type": "string",
      "minLength": 5,
      "maxLength": 25,
      "metadata": {
        "description": "This parameter specifies the name of EventHub namespace"
      }
    },
    "eventHubNamespaceLocation": {
      "type": "string",
      "allowedValues": [
        "Central India",
        "Center US",
        "East US",
        "North Europe",
        "West Europe"
      ],
      "defaultValue": "[resourceGroup().location]"
    },
    "hubName": {
      "type": "string",
      "minLength": 5,
      "maxLength": 25,
      "metadata": {
        "description": "This parameter specifies the name of the Hub in the namespace"
      }
    }
  },
  "variables": {
    "eventHubNamespaceUniqueName": "[concat(parameters('eventHubNamespaceName'),newGuid())]",
    "hubUniqueName": "[concat(parameters('hubName'),newGuid())]",
    "defaultSASKeyName": "RootManageSharedAccessKey",
    "authRuleResourceId": "[resourceId('Microsoft.EventHub/namespaces/authorizationRules',variables('eventHubNamespaceUniqueName'),variables('defaultSASKeyName'))]",
    "eventHubApiVersion": "2018-01-01-preview"
  },
  "resources": [
    {
      "type": "Microsoft.EventHub/namespaces",
      "apiVersion": "2018-01-01-preview",
      "name": "[variables('eventHubNamespaceUniqueName')]",
      "location": "[parameters('eventHubNamespaceLocation')]",
      "sku": {
        "name": "Standard",
        "tier": "Standard"
      },
      "properties": {},
      "resources": [
        {
          "type": "eventhubs",
          "apiVersion": "2017-04-01",
          "name": "[variables('hubUniqueName')]",
          "dependsOn": [
            "[variables('eventHubNamespaceUniqueName')]"
          ],
          "properties": {
            "messageRetentionInDays": 1,
            "partitionCount": 2,
            "status": "Active"
          }
        }
      ]
    }
  ],
  "outputs": {
    "eventHubNamespaceConString": {
      "type": "string",
      "value": "[listKeys(variables('authRuleResourceId'),variables('eventHubApiVersion')).primaryConnectionString]"
    },
    "eventHubSASPrimaryKey": {
      "type": "string",
      "value": "[listKeys(variables('authRuleResourceId'),variables('eventHubApiVersion')).keys[0]]"
    }
  }
}
