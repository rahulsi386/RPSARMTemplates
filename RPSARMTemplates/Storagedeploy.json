{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "storageName": {
      "type": "string",
      "minLength": 5,
      "maxLength": 23
    },
    "storageLocation": {
      "type": "string",
      "allowedValues": [
        "Central India",
        "Center US",
        "East US",
        "North Europe",
        "West Europe"
      ],
      "defaultValue": "West Europe"
    },
    "storageType": {
      "type": "string",
      "allowedValues": [
        "BlobStorage",
        "StorageV2"
      ],
      "defaultValue": "StorageV2"
    },
    "storageSKU": {
      "type": "string",
      "allowedValues": [
        "Standard_LRS",
        "Standard_ZRS",
        "Standard_GRS",
        "Premium_LRS",
        "Premium_ZRS"
      ],
      "defaultValue": "Standard_LRS"
    },
    "blobContainerName": {
      "type": "string",
      "minLength": 5,
      "maxLength": 20,
      "metadata": {
        "description": "This parameter assigns a name to Blob container"
      }
    }
  },
  "variables": {
    "storageUniqueName": "[concat(parameters('storageName'),'storage')]",
    "blobContainerUniqueName": "[concat(parameters('blobContainerName'),'container')]"
  },
  "resources": [
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2019-06-01",
      "name": "[variables('storageUniqueName')]",
      "location": "[parameters('storageLocation')]",
      "kind": "[parameters('storageType')]",
      "sku": {
        "name": "[parameters('storageSKU')]",
        "tier": "[if(contains(parameters('storageSKU'),'Standard'),'Standard','Premium' )]"
      },
      "properties": {
        "accessTier": "Hot",
        "supportsHttpsTrafficOnly": true
      },
      "resources": [
        {
          "type": "blobServices",
          "apiVersion": "2019-06-01",
          "name": "default",
          "dependsOn": [
            "[variables('storageUniqueName')]"
          ],
          "properties": {
          },
          "metadata": {
            "description": "This resource definition creates a blob container in storage account"
          },
          "resources": [
            {
              "type": "containers",
              "apiVersion": "2019-06-01",
              "name": "[variables('blobContainerUniqueName')]",
              "properties": {
                "publicAccess": "None"
              }
            }
          ]
        }
      ]
    }
  ],
  "outputs": {
    "storageAccountEndpoint": {
      "type": "object",
      "value": "[reference(variables('storageUniqueName')).primaryEndpoints]"
    },
    "storageContainerEndpoint": {
      "type": "string",
      "value": "[reference(variables('storageUniqueName')).primaryEndpoints]"
    }
  }
}
